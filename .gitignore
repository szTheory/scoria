# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/
tmp/warning-inventory/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
scoria-*.tar

# macOS Finder metadata.
.DS_Store

# Screenshot harness outputs — belt-and-suspenders guard (priv/shots/.gitignore
# is the primary policy; this catches captures outside that subdirectory).
# Only priv/shots/gap_register.md is committed.
priv/shots/**/*.png
priv/shots/**/*.json

# Dev-only Playwright harness install (priv/dev is excluded from the Hex package;
# node_modules + lockfile are local install artifacts, not committed).
priv/dev/node_modules/
priv/dev/package-lock.json

# Dev-only Playwright e2e run artifacts (reports/traces/screenshots are transient).
priv/dev/test-results/
priv/dev/e2e/test-results/
priv/dev/e2e/playwright-report/

.env
