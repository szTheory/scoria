# syntax=docker/dockerfile:1
#
# Dev-only image for the Scoria dashboard harness. Scoria is a Hex library, so
# this image exists purely to run the dev host harness (mix phx.server via
# dev/DevEndpoint) and the screenshot/critique loop — never for production.
#
# Layer order is deliberate: copy mix.exs/mix.lock + config FIRST so the
# dep-fetch/compile layers stay cached when only source changes. In day-to-day
# dev the source is bind-mounted and deps/_build live in named volumes (see
# compose.yml), so edits never re-fetch deps — this image build is just the
# cold-start baseline.
#
# Pinned to .tool-versions: erlang 27.3.2 / elixir 1.19.5-otp-27.
FROM hexpm/elixir:1.19.5-erlang-27.3.2-debian-bookworm-20260518-slim

# build-essential: NIF compilation; git: hex deps from git; inotify-tools:
# native file watching when run on a Linux host (macOS uses fs_poll, see config).
#
# BuildKit apt cache: keep downloaded .debs + lists across rebuilds so a cold
# `docker compose build` re-uses them instead of re-downloading. (Drop the
# default docker-clean hook that would purge the cache, and don't rm the lists.)
RUN rm -f /etc/apt/apt.conf.d/docker-clean \
  && echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update -y \
  && apt-get install -y --no-install-recommends build-essential git inotify-tools ca-certificates

WORKDIR /app

RUN mix local.hex --force && mix local.rebar --force

ENV MIX_ENV=dev \
    LANG=C.UTF-8

# 1) Dependency manifests only — this layer re-runs only when deps change.
#    BuildKit cache for the Hex package cache: a re-run after a lockfile change
#    re-fetches only what changed instead of the whole tree. (deps land in
#    /app/deps in the layer; only the download cache is mounted.)
COPY mix.exs mix.lock ./
RUN --mount=type=cache,target=/root/.hex,sharing=locked \
    mix deps.get

# 2) Compile-time config before deps.compile (Elixir deps read config at compile time).
#    Cache the rebar3 build cache for NIF/rebar deps across rebuilds.
COPY config config
RUN --mount=type=cache,target=/root/.hex,sharing=locked \
    --mount=type=cache,target=/root/.cache/rebar3,sharing=locked \
    mix deps.compile

# INVARIANT: volatile source (lib/dev/priv) MUST stay below deps.get + deps.compile.
# Reordering re-fetches/recompiles deps on every source edit. Layer order is deliberate
# — see docs/docker_dev_dx.md (layer-invalidation table). Guarded by
# test/scoria/ci_policy_contract_test.exs.
# 3) Volatile source last — editing these does NOT invalidate the layers above.
COPY lib lib
COPY dev dev
COPY priv priv

RUN mix compile

EXPOSE 4000

# Entrypoint sets up the DB (idempotent), prints the URL banner, and serves.
COPY docker/dev-entrypoint.sh /usr/local/bin/dev-entrypoint.sh
RUN chmod +x /usr/local/bin/dev-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/dev-entrypoint.sh"]
